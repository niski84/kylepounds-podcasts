  {
   "start": 777.48,
   "end": 778.64,
   "text": "Whatever I am at now."
  },
  {
   "start": 778.74,
   "end": 780.18,
   "text": "The problem that is going on."
  },
  {
   "start": 780.22,
   "end": 781.32,
